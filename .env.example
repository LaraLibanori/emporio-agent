# ---------------------------------------------------------------
# Provedor do modelo
#   openai     -> qualquer API compatível com OpenAI (OpenAI, Gemini,
#                 Groq, OpenRouter, Ollama local...). Ajuste BASE_URL.
#   anthropic  -> API da Anthropic (pip install -e ".[anthropic]")
# ---------------------------------------------------------------
LLM_PROVIDER=openai

# --- Opção A: Google Gemini (tier gratuito) via endpoint compatível com OpenAI
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-2.5-flash
LLM_API_KEY=coloque-sua-chave-aqui

# --- Opção B: OpenAI
# LLM_BASE_URL=
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=sk-...

# --- Opção C: Groq (gratuito)
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_API_KEY=gsk_...

# --- Opção D: Ollama local (sem chave)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:7b-instruct
# LLM_API_KEY=ollama

# --- Opção E: Anthropic
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-haiku-4-5
# LLM_API_KEY=sk-ant-...

LLM_TEMPERATURE=0.2

# Data "de hoje" usada pelo agente (YYYY-MM-DD ou YYYY-MM-DDTHH:MM).
# Vazio = relógio real em America/Campo_Grande. Útil para demonstrar
# regras de prazo (arrependimento, garantia) com os pedidos do dataset.
AGENT_NOW=

# Onde salvar histórico de conversas e chamados de atendimento humano
AGENT_STATE_DIR=var
